<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="minimal">
    <physics name="deterministic_1ms" type="ignored">
      <max_step_size>.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-logical-camera-system" name="gz::sim::systems::LogicalCamera" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>.5 .5 .5 1</ambient>
      <background>.62 .75 .83 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <diffuse>.9 .9 .85 1</diffuse>
      <specular>.2 .2 .2 1</specular>
      <direction>-.4 .2 -.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <pose>8 0 -.1 0 0 0</pose>
      <link name="link">
        <visual name="visual_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>80 80 .2</size>
            </box>
          </geometry>
          <material>
            <ambient>.58 .52 .4 1</ambient>
            <diffuse>.58 .52 .4 1</diffuse>
          </material>
        </visual>
        <collision name="collision_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>80 80 .2</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>
    <include>
      <uri>model://robot</uri>
      <name>robot</name>
      <pose>0 0 .02 0 0 0</pose>
    </include>
    <model name="sensor_target">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>
      <link name="link">
        <visual name="visual_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>1 2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>.82 .25 .08 1</ambient>
            <diffuse>.82 .25 .08 1</diffuse>
          </material>
        </visual>
        <collision name="collision_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>1 2 2</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>
    <model name="side_wall">
      <static>true</static>
      <pose>0 5 1 0 0 0</pose>
      <link name="link">
        <visual name="visual_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>8 .3 2</size>
            </box>
          </geometry>
          <material>
            <ambient>.6 .65 .7 1</ambient>
            <diffuse>.6 .65 .7 1</diffuse>
          </material>
        </visual>
        <collision name="collision_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>8 .3 2</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>
  </world>
</sdf>