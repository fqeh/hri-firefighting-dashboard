<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="uav">
    <static>true</static>
    <pose>6 0 8 0 0 0</pose>
    <link name="base_link">
      <visual name="body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>.6 .4 .16</size>
          </box>
        </geometry>
        <material>
          <ambient>.85 .87 .9 1</ambient>
          <diffuse>.85 .87 .9 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>.6 .4 .16</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="cross_a_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.4 .08 .06</size>
          </box>
        </geometry>
        <material>
          <ambient>.14 .18 .2 1</ambient>
          <diffuse>.14 .18 .2 1</diffuse>
        </material>
      </visual>
      <visual name="cross_b_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>.08 1.4 .06</size>
          </box>
        </geometry>
        <material>
          <ambient>.14 .18 .2 1</ambient>
          <diffuse>.14 .18 .2 1</diffuse>
        </material>
      </visual>
      <visual name="rotor_0_visual">
        <pose>0.62 0 .1 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.23</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>.2 .2 .25 .7</ambient>
          <diffuse>.2 .2 .25 .7</diffuse>
        </material>
      </visual>
      <visual name="rotor_1_visual">
        <pose>-0.62 0 .1 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.23</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>.2 .2 .25 .7</ambient>
          <diffuse>.2 .2 .25 .7</diffuse>
        </material>
      </visual>
      <visual name="rotor_2_visual">
        <pose>0 0.62 .1 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.23</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>.2 .2 .25 .7</ambient>
          <diffuse>.2 .2 .25 .7</diffuse>
        </material>
      </visual>
      <visual name="rotor_3_visual">
        <pose>0 -0.62 .1 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.23</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>.2 .2 .25 .7</ambient>
          <diffuse>.2 .2 .25 .7</diffuse>
        </material>
      </visual>
      <sensor name="logical_camera" type="logical_camera">
        <pose>0 0 -.12 0 1.57079632679 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/uav/detections</topic>
        <logical_camera>
          <near>.05</near>
          <far>25</far>
          <horizontal_fov>2.3</horizontal_fov>
          <aspect_ratio>1</aspect_ratio>
        </logical_camera>
      </sensor>
      <sensor name="camera" type="camera">
        <pose>0 0 -.15 0 1.57079632679 0</pose>
        <topic>/uav/camera/image</topic>
        <update_rate>3</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.9</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>.1</near>
            <far>60</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>uav/base_link</robot_base_frame>
      <odom_topic>/uav/odom</odom_topic>
      <tf_topic>/uav/pose_tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>