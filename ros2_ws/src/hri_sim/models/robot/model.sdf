<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="robot">
    <pose>0 0 .02 0 0 0</pose>
    <link name="base_link">
      <pose>0 0 .24 0 0 0</pose>
      <inertial>
        <mass>12</mass>
        <inertia>
          <ixx>0.5</ixx>
          <iyy>0.5</iyy>
          <izz>0.5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>.8 .48 .22</size>
          </box>
        </geometry>
        <material>
          <ambient>.12 .32 .38 1</ambient>
          <diffuse>.12 .32 .38 1</diffuse>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>.8 .48 .22</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <sensor name="logical_camera" type="logical_camera">
        <pose>.3 0 .2 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/robot/detections</topic>
        <logical_camera>
          <near>.05</near>
          <far>14</far>
          <horizontal_fov>1.7</horizontal_fov>
          <aspect_ratio>1</aspect_ratio>
        </logical_camera>
      </sensor>
      <sensor name="lidar" type="gpu_lidar">
        <pose>.18 0 .25 0 0 0</pose>
        <gz_frame_id>laser_frame</gz_frame_id>
        <topic>/robot/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>.08</min>
            <max>30</max>
            <resolution>.01</resolution>
          </range>
        </lidar>
      </sensor>
      <sensor name="imu" type="imu">
        <topic>/robot/imu</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <imu />
      </sensor>
      <sensor name="camera" type="camera">
        <pose>.41 0 .17 0 0 0</pose>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <topic>/robot/camera/image</topic>
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>.05</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>.15 0.32 .16 -1.57079632679 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.013</ixx>
          <iyy>0.013</iyy>
          <izz>0.013</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="tire_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>.07 .08 .09 1</ambient>
          <diffuse>.07 .08 .09 1</diffuse>
        </material>
      </visual>
      <collision name="tire_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="left_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <link name="right_wheel">
      <pose>.15 -0.32 .16 -1.57079632679 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.013</ixx>
          <iyy>0.013</iyy>
          <izz>0.013</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="tire_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>.07 .08 .09 1</ambient>
          <diffuse>.07 .08 .09 1</diffuse>
        </material>
      </visual>
      <collision name="tire_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.1</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="right_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>
    <link name="caster">
      <pose>-.29 0 .1 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="caster_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.1</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>.1 .1 .1 1</ambient>
          <diffuse>.1 .1 .1 1</diffuse>
        </material>
      </visual>
      <collision name="caster_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.1</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0</mu>
              <mu2>0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_joint</left_joint>
      <right_joint>right_joint</right_joint>
      <wheel_separation>.64</wheel_separation>
      <wheel_radius>.16</wheel_radius>
      <topic>/robot/cmd_vel</topic>
      <odom_topic>/robot/odom</odom_topic>
      <tf_topic>/robot/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>1.2</max_linear_velocity>
      <min_linear_velocity>-1.2</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <max_linear_acceleration>.8</max_linear_acceleration>
      <min_linear_acceleration>-.8</min_linear_acceleration>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>robot/base_footprint</robot_base_frame>
      <odom_topic>/evaluation/robot_pose</odom_topic>
      <tf_topic>/evaluation/robot_pose_tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>