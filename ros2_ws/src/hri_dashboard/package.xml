<?xml version="1.0"?>
<package format="3">
  <name>hri_dashboard</name><version>0.1.0</version>
  <description>Local HTTP gateway for genuine Gazebo and HRI ROS telemetry.</description>
  <maintainer email="maintainers@example.invalid">HRI project contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
  <exec_depend>std_srvs</exec_depend>
</package>
